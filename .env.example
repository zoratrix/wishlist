# «Хотелки» — пример настроек для production (Docker).
# Скопируйте этот файл в .env и заполните значения. .env НЕ коммитится.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Адрес, по которому сайт открывается у людей (для ссылок в письмах).
# Пример: https://hotelets.example.com
APP_ORIGIN=https://hotelets.example.com

# Секреты. Сгенерируйте свои два разных значения командой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ
HASH_SECRET=ЗАМЕНИТЕ_НА_ДРУГУЮ_СЛУЧАЙНУЮ_СТРОКУ

# База данных и загрузки.
# В Docker эти пути переопределяются на /data/app.db и /data/uploads
# (см. docker-compose.yml), менять их здесь не нужно.
DATABASE_PATH=./server/data/app.db
UPLOAD_DIR=./uploads

# Максимальный размер загружаемого файла (аватар/обложка), МБ.
MAX_UPLOAD_MB=5

# Часовой пояс сервера (влияет на напоминания о днях рождения).
TZ=Europe/Moscow
LOG_LEVEL=info

# --- Почта (сброс пароля) ---
# Пока SMTP_HOST пуст, письма не отправляются: ссылка сброса показывается
# на странице (только при NODE_ENV=development). Для настоящей отправки
# заполните поля ниже. Подробная инструкция — в отдельном файле.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Хотелки <no-reply@example.com>"
