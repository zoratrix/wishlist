{
  "name": "@wishlist/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/dev.ts",
    "dev:watch": "node --watch --disable-warning=ExperimentalWarning src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --disable-warning=ExperimentalWarning src/db/migrate.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning src/db/seed.ts",
    "db:backup": "node --disable-warning=ExperimentalWarning src/db/backup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
